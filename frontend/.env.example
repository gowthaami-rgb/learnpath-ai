# Copy this file to .env and fill in your Firebase project's web app config.
# Get these values from: Firebase Console > Project Settings > General > Your apps > Web app
# If left unset, the app runs in local-only demo mode (no real accounts, data
# stored in the browser instead) so it's still fully usable without this setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed if you deploy the Flask backend somewhere other than
# the Vite dev proxy (see vite.config.js)
# VITE_API_URL=http://localhost:5000/api
