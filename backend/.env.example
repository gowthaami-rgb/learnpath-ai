# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask
FLASK_ENV=development
PORT=5000

# Optional: MySQL connection (if using MySQL instead of Firebase)
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=learnpath_ai

# Optional: Firebase (if using Firebase Admin SDK)
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
